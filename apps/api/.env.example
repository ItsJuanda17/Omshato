# Puerto del API. El front usa el 3000.
PORT=3001

# Base de datos. Coincide con el servicio de docker-compose.yml en la raíz.
DATABASE_URL=postgres://omshato:omshato@localhost:5432/omshato

# Dirección del front que puede llamar al API (CORS).
CORS_ORIGIN=http://localhost:3000

# Sesión del administrador (REQ-AUT-5). Valores de referencia hasta cerrar TBD-17.
# Cierre por inactividad y duración máxima de la sesión: número y unidad (s, m, h, d).
SESION_INACTIVIDAD=30m
SESION_DURACION_MAXIMA=12h

# Bloqueo de la cuenta tras intentos fallidos seguidos (REQ-AUT-4, TBD-17).
AUTH_MAX_INTENTOS=5
AUTH_BLOQUEO_MINUTOS=15

# Carpeta donde se guardan las fotos de los relojes (disco local).
ALMACENAMIENTO_RUTA=./storage

# Límite de solicitudes por IP en inicio de sesión y pedidos: activo o apagado.
LIMITE_SOLICITUDES=activo
# Proxies delante del API (0 = ninguno). En producción detrás de un proxy, pon cuántos son.
PROXIES_DE_CONFIANZA=0
