graph MER {
  rankdir=TB;
  graph [fontname="Liberation Sans", bgcolor=white, pad=0.4, splines=true, nodesep=0.35, ranksep=0.9];
  node [fontname="Liberation Sans", fontsize=11, color="#111111", fontcolor="#111111"];
  edge [fontname="Liberation Sans", fontsize=10, color="#111111", fontcolor="#111111"];
  labelloc=t; labeljust=l; fontsize=15; fontname="Liberation Sans Bold";
  label="MER de Omshato · Entidades, relaciones y cardinalidades (mínima, máxima)";
  node [shape=plaintext];
  MARCA [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>MARCA</b></font></td></tr><tr><td align="left" port="id_marca"><u><b>id_marca</b></u></td></tr><tr><td align="left" port="nombre">nombre</td></tr></table>>];
  RELOJ [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>RELOJ</b></font></td></tr><tr><td align="left" port="id_reloj"><u><b>id_reloj</b></u></td></tr><tr><td align="left" port="nombre">nombre</td></tr><tr><td align="left" port="genero">genero</td></tr><tr><td align="left" port="precio_cop">precio_cop</td></tr><tr><td align="left" port="cantidad">cantidad</td></tr><tr><td align="left" port="garantia">garantia</td></tr><tr><td align="left" port="detalle_mecanica">detalle_mecanica</td></tr><tr><td align="left" port="descripcion">descripcion</td></tr><tr><td align="left" port="modo">modo</td></tr><tr><td align="left" port="visible">visible</td></tr><tr><td align="left" port="plazo_estimado">plazo_estimado</td></tr><tr><td align="left" port="url_amigable">url_amigable</td></tr><tr><td align="left" port="fecha_publicacion">fecha_publicacion</td></tr><tr><td align="left" port="fecha_actualizacion">fecha_actualizacion</td></tr></table>>];
  IMAGEN_RELOJ [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>IMAGEN_RELOJ</b></font></td></tr><tr><td align="left" port="id_imagen"><u><b>id_imagen</b></u></td></tr><tr><td align="left" port="archivo">archivo</td></tr><tr><td align="left" port="orden">orden</td></tr><tr><td align="left" port="es_principal">es_principal</td></tr></table>>];
  PEDIDO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>PEDIDO</b></font></td></tr><tr><td align="left" port="id_pedido"><u><b>id_pedido</b></u></td></tr><tr><td align="left" port="numero_pedido">numero_pedido</td></tr><tr><td align="left" port="nombre_reloj">nombre_reloj</td></tr><tr><td align="left" port="precio_reloj">precio_reloj</td></tr><tr><td align="left" port="modo_reloj">modo_reloj</td></tr><tr><td align="left" port="nombre_comprador">nombre_comprador</td></tr><tr><td align="left" port="telefono_comprador">telefono_comprador</td></tr><tr><td align="left" port="direccion">direccion</td></tr><tr><td align="left" port="fecha_autorizacion_datos">fecha_autorizacion_datos</td></tr><tr><td align="left" port="motivo_cancelacion">motivo_cancelacion</td></tr><tr><td align="left" port="clave_idempotencia">clave_idempotencia</td></tr><tr><td align="left" port="fecha_creacion">fecha_creacion</td></tr></table>>];
  ESTADO_PEDIDO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>ESTADO_PEDIDO</b></font></td></tr><tr><td align="left" port="id_estado"><u><b>id_estado</b></u></td></tr><tr><td align="left" port="nombre">nombre</td></tr></table>>];
  HISTORIAL_ESTADO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>HISTORIAL_ESTADO</b></font></td></tr><tr><td align="left" port="id_historial"><u><b>id_historial</b></u></td></tr><tr><td align="left" port="fecha_hora">fecha_hora</td></tr></table>>];
  NOTA_PEDIDO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>NOTA_PEDIDO</b></font></td></tr><tr><td align="left" port="id_nota"><u><b>id_nota</b></u></td></tr><tr><td align="left" port="texto">texto</td></tr><tr><td align="left" port="fecha_hora">fecha_hora</td></tr></table>>];
  ADMINISTRADOR [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>ADMINISTRADOR</b></font></td></tr><tr><td align="left" port="id_administrador"><u><b>id_administrador</b></u></td></tr><tr><td align="left" port="nombre">nombre</td></tr><tr><td align="left" port="correo">correo</td></tr><tr><td align="left" port="contrasena_hash">contrasena_hash</td></tr><tr><td align="left" port="intentos_fallidos">intentos_fallidos</td></tr><tr><td align="left" port="bloqueado_hasta">bloqueado_hasta</td></tr><tr><td align="left" port="fecha_creacion">fecha_creacion</td></tr></table>>];
  HISTORIAL_PRECIO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>HISTORIAL_PRECIO</b></font></td></tr><tr><td align="left" port="id_cambio"><u><b>id_cambio</b></u></td></tr><tr><td align="left" port="precio_anterior">precio_anterior</td></tr><tr><td align="left" port="precio_nuevo">precio_nuevo</td></tr><tr><td align="left" port="fecha_hora">fecha_hora</td></tr></table>>];
  DEPARTAMENTO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>DEPARTAMENTO</b></font></td></tr><tr><td align="left" port="id_departamento"><u><b>id_departamento</b></u></td></tr><tr><td align="left" port="codigo_dane">codigo_dane</td></tr><tr><td align="left" port="nombre">nombre</td></tr></table>>];
  CIUDAD [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>CIUDAD</b></font></td></tr><tr><td align="left" port="id_ciudad"><u><b>id_ciudad</b></u></td></tr><tr><td align="left" port="codigo_dane">codigo_dane</td></tr><tr><td align="left" port="nombre">nombre</td></tr></table>>];
  ENLACE_CONTACTO [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="white"><tr><td bgcolor="#111111" align="center"><font color="white"><b>ENLACE_CONTACTO</b></font></td></tr><tr><td align="left" port="id_enlace"><u><b>id_enlace</b></u></td></tr><tr><td align="left" port="tipo">tipo</td></tr><tr><td align="left" port="valor">valor</td></tr><tr><td align="left" port="activo">activo</td></tr></table>>];
  node [shape=diamond, style=filled, fillcolor="#F2F2F2", fontsize=10, width=1.3, height=0.8, margin="0.02,0.02"];
  r1 [label="agrupa"];
  r2 [label="tiene fotos"];
  r3 [label="se solicita en"];
  r4 [label="está en"];
  r5 [label="registra"];
  r6 [label="deja en"];
  r7 [label="realiza"];
  r8 [label="tiene notas"];
  r9 [label="escribe"];
  r10 [label="cambia de precio"];
  r11 [label="autoriza"];
  r12 [label="contiene"];
  r13 [label="recibe"];
  MARCA -- r1 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r1 -- RELOJ [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  RELOJ -- r2 [taillabel="(1,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r2 -- IMAGEN_RELOJ [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  RELOJ -- r3 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r3 -- PEDIDO [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  PEDIDO -- r4 [taillabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  r4 -- ESTADO_PEDIDO [headlabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  PEDIDO -- r5 [taillabel="(1,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r5 -- HISTORIAL_ESTADO [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  HISTORIAL_ESTADO -- r6 [taillabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  r6 -- ESTADO_PEDIDO [headlabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  ADMINISTRADOR -- r7 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r7 -- HISTORIAL_ESTADO [headlabel="(0,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  PEDIDO -- r8 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r8 -- NOTA_PEDIDO [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  ADMINISTRADOR -- r9 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r9 -- NOTA_PEDIDO [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  RELOJ -- r10 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r10 -- HISTORIAL_PRECIO [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  ADMINISTRADOR -- r11 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r11 -- HISTORIAL_PRECIO [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  DEPARTAMENTO -- r12 [taillabel="(1,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r12 -- CIUDAD [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  CIUDAD -- r13 [taillabel="(0,N)", labeldistance=2.3, labelangle=0, fontsize=10];
  r13 -- PEDIDO [headlabel="(1,1)", labeldistance=2.3, labelangle=0, fontsize=10];
  nota [shape=note, style=filled, fillcolor="#F2F2F2", fontsize=9.5, margin="0.15,0.1", label="Identificador subrayado. ENLACE_CONTACTO no se relaciona con otras entidades.\nPEDIDO guarda nombre_reloj y precio_reloj del momento de la compra (RN-7).\nHISTORIAL_ESTADO guarda solo el estado nuevo; el anterior es la fila previa del mismo pedido."];
}
